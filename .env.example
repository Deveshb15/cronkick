# Postgres 17 (DigitalOcean managed: use the private-network URI, with ?sslmode=require)
DATABASE_URL=postgres://cronkick:CHANGE_ME@localhost/cronkick
PORT=3000
BASE_URL=https://cronkick.xyz
# Shown on /privacy and /terms
CONTACT_EMAIL=

# GitHub App (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=cronkick
# Servers: path to the .pem (systemd env files can't hold multi-line values). Local: the PEM on one line with \n.
GITHUB_PRIVATE_KEY_FILE=/etc/cronkick/github-app.pem
# GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random 32+ bytes: openssl rand -hex 32
SESSION_SECRET=

# Resend (email). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
MAIL_FROM=Cronkick <alerts@mail.cronkick.xyz>

# Probe repos for the public lateness page (comma-separated owner/name) and a read-only token for them
PROBE_REPOS=
PROBE_TOKEN=

# PostHog: optional. Defaults to the production project (src/posthog-config.ts); set these to send dev events elsewhere.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Postgres 17 (DigitalOcean managed: use the private-network URI, with ?sslmode=require)
DATABASE_URL=postgres://ontime:CHANGE_ME@localhost/ontime
PORT=3000
BASE_URL=https://ontime.devesh.fun
# Shown on /privacy and /terms
CONTACT_EMAIL=

# GitHub App (Settings → Developer settings → GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=ontime
# PEM contents with \n for newlines, or load it from a root-only file in the systemd unit
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random 32+ bytes: openssl rand -hex 32
SESSION_SECRET=

# Resend (email). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
MAIL_FROM=Ontime <alerts@mail.ontime.devesh.fun>

# Probe repos for the public lateness page (comma-separated owner/name) and a read-only token for them
PROBE_REPOS=
PROBE_TOKEN=

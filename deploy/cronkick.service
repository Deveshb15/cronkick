# /etc/systemd/system/cronkick.service
[Unit]
Description=Cronkick worker (scheduler, webhooks) on :3001
After=network-online.target
Wants=network-online.target

[Service]
User=cronkick
WorkingDirectory=/opt/cronkick/current
EnvironmentFile=/etc/cronkick/env
# tsx directly (not npm) so SIGTERM reaches the app and in-flight dispatches drain.
ExecStart=/opt/cronkick/current/node_modules/.bin/tsx src/main.ts
Restart=always
RestartSec=2
# The app drains in-flight dispatches on SIGTERM (up to 15 s).
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
